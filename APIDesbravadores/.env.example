# Copie para .env na pasta do pom.xml e preencha somente no ambiente local.
# Este arquivo contém exemplos públicos; nunca inclua valores do deploy.

# Obrigatórias: conexão com um banco existente e chave de autenticação.
DB_URL=jdbc:mysql://localhost:3306/banco_exemplo
DB_USER=
DB_PASSWORD=
# Gere uma chave aleatória privada de pelo menos 32 bytes; não use texto de exemplo.
JWT_SECRET=

# Origem do front-end: CORS e links dos e-mails. Sem barra final.
FRONTEND_URL=http://localhost:5173
# false no localhost; true quando servido por HTTPS em produção.
COOKIE_SECURE=false

# SMTP: necessário para convites e avisos de evidências por e-mail.
# Desabilitado por padrão para evitar envio acidental ao copiar este arquivo.
MAIL_ENABLED=false
MAIL_FROM=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
# Mailpit local: localhost:1025, sem autenticação nem STARTTLS; captura mensagens.
# Gmail: smtp.gmail.com, porta 587, AUTH=true e STARTTLS=true.
# Para Gmail, MAIL_USERNAME e MAIL_FROM recebem seu remetente;
# MAIL_PASSWORD recebe uma senha de app, preenchida apenas no .env privado.
# Ative MAIL_ENABLED somente após configurar o serviço escolhido.

# Pasta local privada para evidências; precisa permitir gravação.
APP_UPLOADS_DIR=./uploads
